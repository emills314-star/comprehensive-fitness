{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comprehensive-fitness.local/schemas/redesign-app-data.v3.schema.json",
  "title": "Comprehensive Fitness Redesign App Data",
  "type": "object",
  "required": [
    "appDataVersion",
    "sessions",
    "exercises",
    "sets",
    "templates",
    "dataRevision",
    "settings"
  ],
  "properties": {
    "appDataVersion": { "const": 3 },
    "sessions": { "type": "array", "items": { "type": "object" } },
    "exercises": { "type": "array", "items": { "type": "object" } },
    "sets": { "type": "array", "items": { "type": "object", "properties": { "targetRestSeconds": { "type": "integer", "minimum": 15, "maximum": 3600 } }, "additionalProperties": true } },
    "templates": { "type": "array", "items": { "type": "object", "properties": { "scheduledWeekdays": { "type": "array", "uniqueItems": true, "items": { "enum": ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"] } } }, "additionalProperties": true } },
    "dataRevision": { "type": "integer", "minimum": 0 },
    "settings": { "type": "object" }
  },
  "additionalProperties": true,
  "x-contract-version": "comprehensive-fitness-app-data/3.0.0",
  "x-boundary": "Target active domain. Legacy planning/equipment fields are compatibility input, not active state."
}
