# Never deploy raw or derived personal health data with the public application.
personal_fitness_data/**
www/private-personal-data/**
private-personal-data/**

# Never upload local credentials, tool state, generated evidence, or private
# screenshot-derived design references with a source deployment.
.env
.env.*
.claude/**
.vercel/**
.vercel-data/**
artifacts/**
docs/design/strong-ui-mockups/**

# Local exports, backups, and databases are not public application assets.
**/backups/**
**/exports/**
!research_database/exports/
!research_database/exports/json/
!research_database/exports/json/exercise_database.json
!research_database/exports/json/exercise_muscle_map.json
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.bak
**/*.backup
